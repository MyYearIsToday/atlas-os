# Copy to .env for local development. NEVER put real values in a file that
# isn't .env.example — .gitignore already excludes .env and .env.* except
# this file. In Render, these are configured in the service's Environment
# tab, never in a committed file. See DEPLOYMENT.md.

# --- Required: AI provider credentials (server-side only, never VITE_*) ---
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# --- Recommended for any real deployment ---
# Shared secret the frontend must send as the x-atlas-proxy-secret header.
# If unset, the proxy accepts unauthenticated requests (fine for local dev
# only) and logs a startup warning.
ATLAS_PROXY_SHARED_SECRET=

# Comma-separated list of origins allowed to call this proxy via CORS.
# If unset, no CORS headers are emitted (deny-by-default).
ATLAS_ALLOWED_ORIGIN=

# --- Scout discovery (disabled by default; do not enable until reviewed) ---
SCOUT_DISCOVERY_ENABLED=false
# Live discovery requires SCOUT_DISCOVERY_SOURCE=overpass and all settings below.
SCOUT_DISCOVERY_SOURCE=
SCOUT_DISCOVERY_LATITUDE=
SCOUT_DISCOVERY_LONGITUDE=
SCOUT_DISCOVERY_RADIUS_METERS=
SCOUT_DISCOVERY_CATEGORIES=
SCOUT_DISCOVERY_INTERVAL_MS=
# Optional Overpass endpoint override; the public instance is used when unset.
OVERPASS_API_URL=

# --- Optional multimodal business intelligence (disabled by default) ---
# Analyses up to three relevant, public website images through the existing workforce provider.
# Requires the Atlas pipeline and workforce; does not enable mission execution or autonomy.
ATLAS_MULTIMODAL_ENABLED=false

# --- Provided automatically by Render, no action needed there ---
# PORT=

# --- Durable pipeline + automation (names derived from server/ai-proxy-server.ts; NEVER commit real values) ---
# PostgreSQL. REQUIRED when ATLAS_PIPELINE_ENABLED=true on Render: startup aborts (exit 1) without it, by design.
# On Render use the database's INTERNAL URL (same region as the service). Migrations run automatically at startup.
DATABASE_URL=
# Turns on the downstream pipeline (evidence -> score -> audit -> mission) and durable state. Needs DATABASE_URL.
# NOTE: the pipeline is only created inside the Scout startup path, so SCOUT_DISCOVERY_ENABLED=true and a valid
# SCOUT_DISCOVERY_* configuration are also required.
ATLAS_PIPELINE_ENABLED=false
# Optional comma-separated source allowlist for the pipeline (unset = all sources).
ATLAS_PIPELINE_SOURCES=
# Autonomy loop (internal evidence/score/audit/planning decisions only; external actions always need a human). Needs the pipeline.
ATLAS_AUTONOMY_ENABLED=false
ATLAS_AUTONOMY_INTERVAL_MS=900000
# Mission execution calls paid/rate-limited AI providers (needs OPENROUTER_API_KEY / NVIDIA_API_KEY). Autonomous runs are
# limited to allowlisted internal mission types with Auto approval; everything else needs an explicit human approval.
ATLAS_MISSION_EXECUTION_ENABLED=false
# Provider/data keys read by the code (server-side only):
TAVILY_API_KEY=
GEOAPIFY_API_KEY=
