# Copy to .env for local development. NEVER put real values in a file that
# isn't .env.example — .gitignore already excludes .env and .env.* except
# this file. In Render, these are configured in the service's Environment
# tab, never in a committed file. See DEPLOYMENT.md.

# --- Required: AI provider credentials (server-side only, never VITE_*) ---
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# --- Recommended for any real deployment ---
# Shared secret the frontend must send as the x-atlas-proxy-secret header.
# If unset, the proxy accepts unauthenticated requests (fine for local dev
# only) and logs a startup warning.
ATLAS_PROXY_SHARED_SECRET=

# Comma-separated list of origins allowed to call this proxy via CORS.
# If unset, no CORS headers are emitted (deny-by-default).
ATLAS_ALLOWED_ORIGIN=

# --- Scout discovery (disabled by default; do not enable until reviewed) ---
SCOUT_DISCOVERY_ENABLED=false
# Live discovery requires SCOUT_DISCOVERY_SOURCE=overpass and all settings below.
SCOUT_DISCOVERY_SOURCE=
SCOUT_DISCOVERY_LATITUDE=
SCOUT_DISCOVERY_LONGITUDE=
SCOUT_DISCOVERY_RADIUS_METERS=
SCOUT_DISCOVERY_CATEGORIES=
SCOUT_DISCOVERY_INTERVAL_MS=
# Optional Overpass endpoint override; the public instance is used when unset.
OVERPASS_API_URL=

# --- Provided automatically by Render, no action needed there ---
# PORT=
